{
  "name": "finsight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "start:backend": "cd backend && node src/index.js",
    "start:frontend": "node server.cjs",
    "prestart": "node -e \"const {execSync}=require('child_process');try{execSync('killall -9 node')}catch(e){}\" || true",
    "start": "concurrently -n backend,frontend -c green,blue \"npm run start:backend\" \"npm run start:frontend\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "concurrently": "^10.0.7",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.3",
    "vite": "^4.4.5"
  }
}
